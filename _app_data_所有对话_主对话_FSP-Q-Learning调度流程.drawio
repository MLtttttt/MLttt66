          <mxGeometry height="24" width="250" x="50" y="382" as="geometry" />
        </mxCell>
        <mxCell id="A" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontStyle=1;fontSize=13;" value="页面进入&#xa;DRAM缓存" vertex="1">
          <mxGeometry height="55" width="140" x="60" y="35" as="geometry" />
        </mxCell>
        <mxCell id="B" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontStyle=1;fontSize=11;" value="Agent查表Active-Q&#xa;→ 分配页类型&#xa;(LSB/CLSB/CMSB/MSB)" vertex="1">
          <mxGeometry height="85" width="210" x="260" y="20" as="geometry" />
