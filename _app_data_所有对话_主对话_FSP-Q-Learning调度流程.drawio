        <mxCell id="I" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;" value="慢页热数据回迁DRAM&#xa;原Flash页置无效" vertex="1">
